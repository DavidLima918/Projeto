def carregarProduto(produto, produtos, p):
    parts = produtos[p].split(";")
    produto[0] = parts[0][3:]  # remove "ID:"
    produto[1] = parts[1]
    produto[2] = parts[2]
    produto[3] = parts[3]
    produto[4] = parts[4][:-1]  # remove "€"
    produto[5] = parts[5][:-1]  # remove "x"

