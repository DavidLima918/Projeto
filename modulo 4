        preco = float(input())
        if preco > 0: break
    produto[3] = "" + str(preco)
    print("Indique a quantidade de stock")
    while True:    #This simulates a Do Loop
        stock = int(input())
        if stock > 0: break
    produto[4] = "" + str(stock)
    print("Indique o ID do produto")
    while True:    #This simulates a Do Loop
        id = int(input())
        if id > 0 and id > 9: break
    produto[5] = "" + str(id)

