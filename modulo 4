    print("Descreva brevemente o produto produto")
    descricao = input()
    produto[1] = descricao
    print("Indique a categoria do produto" + chr(13) + "1 - Metálico" + chr(13) + "2 - Cerâmico" + chr(13) + "3 - Polimérico")
